{
  "manifest_version": 3,
  "name": "Hermey Sign-in",
  "version": "0.1.0",
  "description": "Lets Hermey fill a login form without the password ever reaching the bot.",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hermey Sign-in",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}
