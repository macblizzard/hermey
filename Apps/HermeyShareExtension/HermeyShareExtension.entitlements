<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The handoff both halves of this feature need. The app writes the bot snapshot and reads
	     payloads; the extension writes payloads and reads the snapshot. The identifier must be the
	     same string in both targets' entitlements and in ShareInboxStorage.appGroupIdentifier. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.hermey.app</string>
	</array>
</dict>
</plist>
