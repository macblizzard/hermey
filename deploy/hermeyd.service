[Unit]
Description=Hermey host service (hermeyd) — pairing, devices, tickets
Documentation=https://github.com/macblizzard/hermey/blob/main/docs/HERMEYD.md
After=network-online.target
Wants=network-online.target

[Service]
# `User` is the engine's owner: hermeyd writes a bot's skill into the engine's profiles. Keep it in
# step with `<engine>/plugins/hermes-genui`, which the service reads.
User=hermey
Group=hermey
WorkingDirectory=/opt/hermey
EnvironmentFile=-/etc/hermey/hermeyd.env
ExecStart=/opt/hermey/bin/hermeyd
Restart=always
RestartSec=2

# Loopback networking and its own state, nothing else. ProtectHome is deliberately off: the engine
# home is often under the service account's home.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/var/lib/hermeyd
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
